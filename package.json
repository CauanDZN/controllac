{
  "name": "controllac",
  "version": "3.0.0",
  "private": true,
  "main": "index.js",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "lint": "eslint .",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "prepare": "husky"
  },
  "dependencies": {
    "@expo-google-fonts/poppins": "^0.4.1",
    "@expo/vector-icons": "^15.1.1",
    "@hookform/resolvers": "^5.4.0",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-navigation/bottom-tabs": "^7.18.12",
    "@react-navigation/native": "^7.3.12",
    "@react-navigation/native-stack": "^7.18.4",
    "date-fns": "^4.4.0",
    "expo": "~57.0.7",
    "expo-asset": "~57.0.6",
    "expo-audio": "~57.0.2",
    "expo-camera": "~57.0.3",
    "expo-clipboard": "~57.0.1",
    "expo-crypto": "~57.0.1",
    "expo-font": "~57.0.1",
    "expo-linear-gradient": "~57.0.1",
    "expo-notifications": "~57.0.6",
    "expo-splash-screen": "~57.0.4",
    "expo-status-bar": "~57.0.1",
    "react": "19.2.3",
    "react-hook-form": "^7.82.0",
    "react-native": "0.86.0",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-gifted-charts": "^1.4.77",
    "react-native-responsive-fontsize": "^0.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "4.25.2",
    "react-native-svg": "15.15.4",
    "styled-components": "^6.4.4",
    "yup": "^1.7.1"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/react": "~19.2.17",
    "@types/styled-components-react-native": "^5.2.5",
    "babel-plugin-module-resolver": "^5.0.3",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~57.0.0",
    "husky": "^9.1.7",
    "jest": "^29.7.0",
    "jest-expo": "~57.0.2",
    "lint-staged": "^17.1.0",
    "prettier": "^3.9.5",
    "react-test-renderer": "19.2.3",
    "typescript": "~6.0.3"
  },
  "overrides": {
    "eslint-import-resolver-typescript": "3.6.3"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md}": [
      "prettier --write"
    ]
  },
  "jest": {
    "preset": "jest-expo",
    "moduleNameMapper": {
      "^@react-native-async-storage/async-storage$": "@react-native-async-storage/async-storage/jest/async-storage-mock"
    },
    "transformIgnorePatterns": [
      "/node_modules/(?!(.pnpm|react-native|@react-native|@react-native-community|expo|@expo|@expo-google-fonts|react-navigation|@react-navigation|@sentry/react-native|native-base|standard-navigation|react-native-gifted-charts|gifted-charts-core))"
    ]
  }
}
