{
  "expo": {
    "name": "Controllac",
    "slug": "controllac",
    "version": "3.0.0",
    "orientation": "portrait",
    "icon": "./src/assets/logo.png",
    "userInterfaceStyle": "light",
    "backgroundColor": "#320059",
    "ios": {
      "bundleIdentifier": "com.controllac",
      "supportsTablet": false
    },
    "android": {
      "package": "com.controllac",
      "adaptiveIcon": {
        "foregroundImage": "./src/assets/logo.png",
        "backgroundColor": "#320059"
      }
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "image": "./src/assets/logo.png",
          "backgroundColor": "#320059",
          "imageWidth": 180
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "O Controllac usa a câmera para ler o código de barras dos produtos."
        }
      ],
      "expo-asset",
      [
        "expo-notifications",
        {
          "icon": "./src/assets/logo.png",
          "color": "#320059"
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "08a871fc-14ba-4ce2-8b06-69bb0bfb4c93"
      }
    }
  }
}
